<UserControl x:Class="WeaselPanel.App.Views.PackageManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
             xmlns:vm="clr-namespace:WeaselPanel.App.ViewModels">
    <!--
        词库包页 — 排版约定（ui-ux-pro-max 验收口径，与纠错页 / 雾凇页一致）：
        · 层次：页面标题 22 → 卡片小标题 14.5 → 说明 13 → 脚注 11.5 → 徽标 10.5
        · 间距一律 8 的倍数，走 Sp / Gap token
        · 状态点（8px 圆）替代文字前缀，颜色三态：灰=未装 / 绿=面板管理 / 橙=外部存在
        · 破坏性操作（卸载）与主操作分列两端，防误点
        · 能用留白就不用分割线
    -->
    <UserControl.Resources>
        <!-- 状态点：三态一眼可辨，比读文字快 -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKindName}" Value="Installed">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKindName}" Value="External">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 更新徽标：默认中性灰，有新版本时点亮成主色（唯一的主色点缀处） -->
        <Style x:Key="UpdateChip" TargetType="Border" BasedOn="{StaticResource StatusChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Primary100Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpdateChipText" TargetType="TextBlock" BasedOn="{StaticResource StatusChipText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Primary700Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{l10n:L Packages.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L Packages.Intro}" Style="{StaticResource PageIntro}"/>

        <!-- 小狼毫没装出来：整页置灰，但能力先让用户看清 -->
        <Border Style="{StaticResource StatusStrip}" Margin="{StaticResource GapCard}"
                Background="{StaticResource WarningSoftBrush}"
                Visibility="{Binding IsWeaselInstalled, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{l10n:L Packages.NoWeasel}" FontSize="{StaticResource FontBody}"
                           FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
                <TextBlock Text="{l10n:L Packages.NoWeasel.Hint}" Style="{StaticResource FieldNote}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 包列表：一包一卡 ──────────────────────────────────────── -->
        <ItemsControl ItemsSource="{Binding Packages}" IsEnabled="{Binding IsWeaselInstalled}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PackageRow}">
                    <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
                        <StackPanel>
                            <!-- 标题行：状态点 + 包名 + 状态文字 + 更新徽标 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}"
                                         Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           FontSize="{StaticResource FontSection}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           FontSize="{StaticResource FontCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,1,0,0"/>

                                <Border Grid.Column="3" Style="{StaticResource UpdateChip}"
                                        Visibility="{Binding HasUpdateText, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding UpdateText}"
                                               Style="{StaticResource UpdateChipText}"/>
                                </Border>
                            </Grid>

                            <!-- 类型 · 作者 -->
                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource FieldNote}"
                                       Margin="18,6,0,0"/>

                            <!-- 简介 -->
                            <TextBlock Text="{Binding DisplayDescription}"
                                       FontSize="{StaticResource FontBody}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       LineHeight="{StaticResource LineBody}"
                                       TextWrapping="Wrap" Margin="18,10,0,0"/>

                            <!-- 已装版本 / 时间 -->
                            <TextBlock Text="{Binding InstalledInfoText}" Style="{StaticResource MonoText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="18,10,0,0"
                                       Visibility="{Binding HasInstalledInfo, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- 阻塞 / 外部安装提示：把原因先讲清楚，而不是等用户点了才发现按钮是灰的 -->
                            <Border Style="{StaticResource StatusStrip}" Margin="18,14,0,0"
                                    Background="{StaticResource WarningSoftBrush}"
                                    Visibility="{Binding HasBlockedHint, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BlockedHintText}"
                                           FontSize="{StaticResource FontCaption}"
                                           Foreground="{StaticResource WarningBrush}"
                                           LineHeight="{StaticResource LineCaption}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- 操作行：主操作靠左，卸载靠右 -->
                            <Grid Margin="18,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="{l10n:L Packages.Button.Install}"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding CanInstall}"
                                            Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="{l10n:L Packages.Button.Update}"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding UpdateCommand}"
                                            IsEnabled="{Binding CanUpdate}"
                                            Visibility="{Binding ShowManage, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="{l10n:L Packages.Button.Check}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CheckCommand}"
                                            IsEnabled="{Binding CanCheck}"
                                            Visibility="{Binding ShowManage, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="{l10n:L Packages.Button.Homepage}"
                                            Style="{StaticResource TertiaryButton}"
                                            Command="{Binding HomepageCommand}"/>

                                    <TextBlock Text="{l10n:L Packages.Row.Working}"
                                               FontSize="{StaticResource FontCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{l10n:L Packages.Button.Uninstall}"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding UninstallCommand}"
                                        IsEnabled="{Binding CanUninstall}"
                                        Visibility="{Binding ShowManage, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── 工作方式：卸载敢不敢点，全靠这段话讲清楚 ─────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L Packages.How.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L Packages.How.Note}" Style="{StaticResource SectionIntro}"/>

                <Border Style="{StaticResource CodeBlock}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{l10n:L Packages.How.Step1}" Style="{StaticResource FieldNote}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{l10n:L Packages.How.Step2}" Style="{StaticResource FieldNote}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{l10n:L Packages.How.Step3}" Style="{StaticResource FieldNote}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="{l10n:L Packages.Managed.Path}" Style="{StaticResource FieldNote}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ManagedPath}" Style="{StaticResource MonoText}"
                               Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 全局操作与状态 ───────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapActionRow}">
                    <Button Content="{l10n:L Packages.Button.CheckAll}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CheckAllCommand}"
                            IsEnabled="{Binding IsWeaselInstalled}" Margin="0,0,10,0"/>
                    <Button Content="{l10n:L Common.Reload}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ReloadCommand}"/>
                </StackPanel>

                <Border Style="{StaticResource StatusStrip}">
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
