<UserControl x:Class="WeaselPanel.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <StackPanel>
        <TextBlock Text="{l10n:L Inspector.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L Inspector.Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 工具条 ────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{l10n:L Inspector.File}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FileOptions}"
                              SelectedValuePath="BaseName" DisplayMemberPath="Name"
                              SelectedValue="{Binding FileName}"/>

                    <!-- 搜索框。schema.yaml 展开后几百行，没有搜索没法用。
                         键路径和值都参与匹配 —— 用户既可能记得键名，也可能只记得值。 -->
                    <TextBox Grid.Column="3" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l10n:L Inspector.FilterTip}"/>

                    <Button Grid.Column="4" Content="{l10n:L Inspector.Copy}" Command="{Binding CopyCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <Button Grid.Column="5" Content="{l10n:L Common.Refresh}" Command="{Binding ReloadCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <Button Grid.Column="6" Content="{l10n:L Inspector.Locate}" Command="{Binding OpenDirCommand}"
                            Style="{StaticResource TertiaryButton}" Margin="8,0,0,0"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}"/>

                <!-- ── 文件路径 ────────────────────────────────────────────
                     把「哪个文件在生效」摆在最前面。用户最常见的困惑是
                     「我明明改了 Program Files 里那份，怎么没用」——
                     看到这里显示的是 %AppData%\Rime 就明白了。 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:L Inspector.BaseFile}"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BasePathText}"
                               Style="{StaticResource MonoText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- 没有补丁文件时整行压掉，不留一个写着「未找到」的空行 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:L Inspector.PatchFile}"
                               Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                               Visibility="{Binding HasPatch, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchPathText}"
                               Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding HasPatch, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Divider}"/>

                <!-- ── 键值表 ────────────────────────────────────────────── -->
                <Border Grid.Row="4" Style="{StaticResource ListFrame}" Height="330">
                    <Grid>
                        <DataGrid ItemsSource="{Binding EntryView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushKey}"
                                  VerticalGridLinesBrush="Transparent"
                                  RowHeight="28"
                                  RowHeaderWidth="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  AlternatingRowBackground="{StaticResource RowAltBrush}"
                                  RowBackground="{StaticResource CardBgBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridMonoCell}"
                                  RowStyle="{StaticResource GridRow}"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False">

                            <DataGrid.Columns>
                                <!-- 表头文字走 HeaderTemplate 而不是 Header 属性，
                                     这样列标题才能用 {l10n:L} 随语言切换。 -->
                                <DataGridTextColumn Binding="{Binding Path}" Width="2*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{l10n:L Inspector.Column.Path}"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Value}" Width="3*">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{l10n:L Inspector.Column.Value}"/>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <!-- 来源列用模板而不是纯文本：被 custom 补丁覆盖过的行
                                     标出来，「我到底改过哪些」是排查配置时最先想看的。 -->
                                <DataGridTemplateColumn Width="74">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{l10n:L Inspector.Column.Origin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="OriginText" Text="{Binding OriginText}"
                                                       FontSize="{StaticResource FontCaption}"
                                                       Foreground="{StaticResource TextDisabledBrush}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                    <Setter TargetName="OriginText" Property="Foreground"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="OriginText" Property="FontWeight"
                                                            Value="SemiBold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 空状态分两种：这个文件一个键都没有 vs 被搜索过滤光了。
                             文案不同，否则用户会以为配置丢了。 -->
                        <TextBlock Text="{l10n:L Inspector.NoEntries}" Style="{StaticResource EmptyState}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ShowNoEntries, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{l10n:L Inspector.NoMatch}" Style="{StaticResource EmptyState}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ShowFilteredEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- ── 底部汇总 ──────────────────────────────────────────── -->
                <Grid Grid.Row="5" Margin="{StaticResource GapActionRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EntryCountText}" Style="{StaticResource FieldNote}"
                                   Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding OverrideCountText}" Style="{StaticResource FieldNote}"/>

                        <!-- 重新扫描目录只要几十毫秒，但目录在网络盘上时会慢得多，
                             不给反馈用户会连点。 -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource BusySpinner}" Margin="0,0,8,0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="7" CenterY="7"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Text="{l10n:L Common.Working}" FontSize="{StaticResource FontCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{l10n:L Inspector.ClearFilter}"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource TertiaryButton}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource StatusStrip}" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
        </Border>

        <!-- 合并规则。不写清楚，用户看到「值和我文件里写的不一样」会直接判定面板算错了。 -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{l10n:L Inspector.RuleTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L Inspector.RuleBody}" Style="{StaticResource FieldNote}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
