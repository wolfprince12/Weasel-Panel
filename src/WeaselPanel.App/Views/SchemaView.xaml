<UserControl x:Class="WeaselPanel.App.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="输入方案" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="列表顺序即为切换顺序 —— 第一个是默认方案。修改后点「应用」写入 default.custom.yaml 的 patch/schema_list，点「部署」即可在输入法中看到变化。"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="重新扫描" Click="Reload_Click" Height="32"
                        HorizontalAlignment="Left" Padding="14,0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="↑ 上移" Command="{Binding MoveUpCommand}" Height="32"
                        Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="↓ 下移" Command="{Binding MoveDownCommand}" Height="32"
                        Margin="4,0,0,0"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：已启用 -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="已启用" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding ActiveSchemas}"
                                 SelectedItem="{Binding SelectedActive}"
                                 ItemContainerStyle="{StaticResource SchemaItem}"
                                 Height="380">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                            <Border Style="{StaticResource OriginChip}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding OriginLabel}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                    <Button Content="启用 ←" Command="{Binding AddCommand}"
                            Padding="6,4" Margin="0,2"/>
                    <Button Content="→ 移除" Command="{Binding RemoveCommand}"
                            Padding="6,4" Margin="0,2"/>
                </StackPanel>

                <!-- 右侧：可启用 -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="可启用" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding AvailableSchemas}"
                                 SelectedItem="{Binding SelectedAvailable}"
                                 ItemContainerStyle="{StaticResource SchemaItem}"
                                 Height="380">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                            <Border Style="{StaticResource OriginChip}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding OriginLabel}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="应用（写入 default.custom.yaml）" Command="{Binding ApplyCommand}"
                        Height="34" Padding="16,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>