<UserControl x:Class="WeaselPanel.App.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <StackPanel>
        <TextBlock Text="{l10n:L Schema.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L Schema.Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 工具条 ──────────────────────────────────────────────
                     四个按钮宽度按内容自适应，不再写死 120/130 —— 之前英文语言下
                     "Move Down" 会被压成 "Move D…"，而中文下又空出一大截。 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="{l10n:L Schema.Rescan}" Click="Reload_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{l10n:L Schema.MoveUp}" Command="{Binding MoveUpCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{l10n:L Schema.MoveDown}" Command="{Binding MoveDownCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{l10n:L Schema.SetDefault}" Command="{Binding SetDefaultCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="{l10n:L Schema.DefaultLabel}"/>
                </WrapPanel>

                <!-- ── 双栏 ──────────────────────────────────────────────── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：已启用（首位即默认方案） -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l10n:L Schema.Active}"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DefaultSummary}"
                                   Style="{StaticResource FieldNote}" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource ListFrame}">
                            <Grid>
                                <ListBox ItemsSource="{Binding ActiveSchemas}"
                                         SelectedItem="{Binding SelectedActive}"
                                         ItemContainerStyle="{StaticResource SchemaItem}"
                                         BorderThickness="0" Background="Transparent"
                                         Height="360">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontBody}"/>
                                                    <!-- 默认方案标记：由 ViewModel 的 SyncDefault 维护 IsDefault -->
                                                    <Border Style="{StaticResource OriginChip}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{l10n:L Schema.DefaultLabel}"
                                                                   Style="{StaticResource StatusChipText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource OriginChip}" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding OriginLabel}"
                                                                   Style="{StaticResource StatusChipText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource FieldNote}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{l10n:L Schema.NoActive}" Style="{StaticResource EmptyState}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ShowNoActive, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- 中间：启用/移除。箭头方向用文字而非符号，符号在不同字体下
                         宽度不一致，容易把两栏挤歪。 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <Button Content="{l10n:L Schema.Enable}" Command="{Binding AddCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,6" Margin="0,0,0,8"/>
                        <Button Content="{l10n:L Schema.Remove}" Command="{Binding RemoveCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,6" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 右：可启用 -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{l10n:L Schema.Available}"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock DockPanel.Dock="Top" Text="{l10n:L Schema.AvailableNote}"
                                   Style="{StaticResource FieldNote}" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource ListFrame}">
                            <Grid>
                                <ListBox ItemsSource="{Binding AvailableSchemas}"
                                         SelectedItem="{Binding SelectedAvailable}"
                                         ItemContainerStyle="{StaticResource SchemaItem}"
                                         BorderThickness="0" Background="Transparent"
                                         Height="360">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontBody}"/>
                                                    <Border Style="{StaticResource OriginChip}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding OriginLabel}"
                                                                   Style="{StaticResource StatusChipText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource FieldNote}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{l10n:L Schema.NoAvailable}" Style="{StaticResource EmptyState}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ShowNoAvailable, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ── 状态 + 应用 ────────────────────────────────────────── -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                               Style="{StaticResource FieldNote}"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
