<UserControl x:Class="WeaselPanel.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <StackPanel>
        <TextBlock Text="{l10n:L Backup.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L Backup.Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 新建备份 ────────────────────────────────────────────
                     标签输入框不写死 220 —— 用 * 让它吃掉剩余空间，
                     「新建」按钮紧贴右侧。窗口拉宽时输入框跟着变宽。 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l10n:L Backup.Label}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"
                             MaxWidth="320" HorizontalAlignment="Left" MinWidth="180"
                             ToolTip="{l10n:L Backup.LabelTip}"
                             Margin="0,0,16,0"/>
                    <Button Grid.Column="2" Content="{l10n:L Backup.Create}" Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="{l10n:L Common.Refresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}"/>

                <!-- ── 主区：左＝备份列表，右＝文件 + 差异 ───────────────── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：备份列表 -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l10n:L Backup.Records}"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ListFrame}">
                            <Grid>
                                <ListBox ItemsSource="{Binding Backups}"
                                         SelectedItem="{Binding SelectedBackup}"
                                         ItemContainerStyle="{StaticResource SchemaItem}"
                                         BorderThickness="0" Background="Transparent" MinHeight="320">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontBody}"/>
                                                <TextBlock Text="{Binding CreatedText}"
                                                           Style="{StaticResource FieldNote}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Style="{StaticResource FieldNote}">
                                                    <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                    <Run Text=" "/><Run Text="{l10n:L Common.Files}"/><Run Text="　"/>
                                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{l10n:L Backup.NoBackups}" Style="{StaticResource EmptyState}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding ShowNoBackups, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- 右：文件列表 + 差异对比 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{l10n:L Backup.FilesInBackup}"
                                   FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <Border Grid.Row="1" Style="{StaticResource ListFrame}" Height="150">
                            <Grid>
                                <ListBox ItemsSource="{Binding BackupFiles}"
                                         SelectedItem="{Binding SelectedFile}"
                                         ItemContainerStyle="{StaticResource SchemaItem}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                <TextBlock Text="{l10n:L Backup.NoFiles}" Style="{StaticResource EmptyState}"
                                           Padding="16,12" IsHitTestVisible="False"
                                           Visibility="{Binding ShowNoFiles, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{l10n:L Backup.DiffTitle}"
                                       FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- 由 ViewModel 的 ShowNoDiffNotice 控制：已选中文件且对比无差异时才显示 -->
                            <TextBlock Grid.Column="1" Text="{l10n:L Backup.DiffIdentical}"
                                       Style="{StaticResource FieldNote}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowNoDiffNotice, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource ListFrame}" MinHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          Padding="4">
                                <ItemsControl ItemsSource="{Binding DiffLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="Row">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 行号之前用 #FF9A9AA0，对白底只有 2.9:1，
                                                     正文级内容不合格。统一换成 TextSecondary（5.6:1）。 -->
                                                <TextBlock Grid.Column="0" Text="{Binding LeftNo}"
                                                           Style="{StaticResource FieldNote}"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LeftText}"
                                                           Style="{StaticResource MonoText}"
                                                           TextWrapping="NoWrap" Padding="4,2"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RightNo}"
                                                           Style="{StaticResource FieldNote}"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding RightText}"
                                                           Style="{StaticResource MonoText}"
                                                           TextWrapping="NoWrap" Padding="4,2"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <!-- 当前版本新增（备份版没有）：右栏标绿 -->
                                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                </DataTrigger>
                                                <!-- 备份版有、当前已删除：左栏标红 -->
                                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrorSoftBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 恢复 / 删除。删除是破坏性操作，走 DangerButton
                             （ViewModel 里另有一次 MessageBox 二次确认）。 -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{l10n:L Backup.RestoreAll}" Command="{Binding RestoreAllCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{l10n:L Backup.RestoreFile}" Command="{Binding RestoreFileCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{l10n:L Backup.DeleteBackup}" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ── 状态条 ────────────────────────────────────────────────── -->
        <Border Style="{StaticResource StatusStrip}" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontBody}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
        </Border>
    </StackPanel>
</UserControl>
