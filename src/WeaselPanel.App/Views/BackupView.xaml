<UserControl x:Class="WeaselPanel.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 标题 ── -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{l10n:L Backup.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L Backup.Intro}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- ── 操作栏 ── -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{l10n:L Backup.Label}" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         ToolTip="{l10n:L Backup.LabelTip}"/>
                <Button Grid.Column="2" Content="{l10n:L Backup.Create}" Command="{Binding CreateCommand}"
                        Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Margin="8,0,0,0"/>
                <Button Grid.Column="4" Content="{l10n:L Common.Refresh}" Command="{Binding RefreshCommand}"
                        Height="32" Padding="14,0"/>
            </Grid>

            <!-- ── 主区：左＝备份列表，右＝文件 + 差异 ── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：备份列表 -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="{l10n:L Backup.Records}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Backups}"
                                 SelectedItem="{Binding SelectedBackup}"
                                 ItemContainerStyle="{StaticResource SchemaItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding CreatedText}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                            <Run Text=" "/><Run Text="{l10n:L Common.Files}"/><Run Text="　"/>
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- 右：文件列表 + 差异对比 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{l10n:L Backup.FilesInBackup}"
                               FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding BackupFiles}"
                                 SelectedItem="{Binding SelectedFile}"
                                 ItemContainerStyle="{StaticResource SchemaItem}"
                                 FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l10n:L Backup.DiffTitle}"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <!-- 由 ViewModel 的 ShowNoDiffNotice 控制：已选中文件且对比无差异时才显示 -->
                        <TextBlock Grid.Column="1" Text="{l10n:L Backup.DiffIdentical}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowNoDiffNotice, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DiffLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Row">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LeftNo}"
                                                       FontSize="11" Foreground="#FF9A9AA0"
                                                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LeftText}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                                       TextWrapping="NoWrap" Padding="4,1"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RightNo}"
                                                       FontSize="11" Foreground="#FF9A9AA0"
                                                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RightText}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                                       TextWrapping="NoWrap" Padding="4,1"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- 当前版本新增（备份版没有）：右栏标绿 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                <Setter TargetName="Row" Property="Background" Value="#FFDFF5E3"/>
                                            </DataTrigger>
                                            <!-- 备份版有、当前已删除：左栏标红 -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                <Setter TargetName="Row" Property="Background" Value="#FFFDE4E1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 恢复 / 删除 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l10n:L Backup.RestoreAll}" Command="{Binding RestoreAllCommand}"
                                Height="32" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Content="{l10n:L Backup.RestoreFile}" Command="{Binding RestoreFileCommand}"
                                Height="32" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Content="{l10n:L Backup.DeleteBackup}" Command="{Binding DeleteCommand}"
                                Height="32" Padding="14,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── 状态栏 ── -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,8"
                    Background="#FFF0F2F5" CornerRadius="6">
                <TextBlock Text="{Binding Status}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
