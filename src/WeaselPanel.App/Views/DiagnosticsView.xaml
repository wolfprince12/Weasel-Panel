<UserControl x:Class="WeaselPanel.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <!-- ── 环境信息 ─────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="环境" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding EnvironmentRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"
                                           TextWrapping="Wrap" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFC5221F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── 探测 ─────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="环境探测（P0 探针）" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="验证那些无法靠读源码确定的行为：命名管道连通性、部署器退出码、日志文件名格式、librime-lua 可用性。"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="开始探测" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunProbeCommand}" Margin="0,0,10,0"/>
                    <Button Content="执行部署 /deploy" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RunDeployCommand}" Margin="0,0,10,0"/>
                    <Button Content="复制报告" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CopyReportCommand}"/>
                </StackPanel>

                <Border Background="#FFF0F2F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFAFBFC" BorderBrush="{StaticResource BorderBrushKey}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFE8EAED"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="正常">
                                                            <Setter Property="Background" Value="#FFD9F0DC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="警告">
                                                            <Setter Property="Background" Value="#FFFDF0D9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                                            <Setter Property="Background" Value="#FFFBE0DF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
