<UserControl x:Class="WeaselPanel.App.Views.InputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <StackPanel>
        <TextBlock Text="{l10n:L Input.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L Input.Intro}" Style="{StaticResource PageIntro}"/>

        <!-- ── 候选数 ──────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L Input.PageSizeGroup}" Style="{StaticResource SectionTitle}"/>

                <Grid Margin="{StaticResource GapFieldTight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l10n:L Input.PageSize}" Style="{StaticResource FieldLabel}"/>
                    <Slider Grid.Column="1" Minimum="3" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding PageSize}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding PageSize}"
                               FontSize="{StaticResource FontBody}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <!-- 说明文字缩进到与控件左沿对齐（跳过标签列），
                     否则它会挂在标签底下，读起来像是标签的一部分。 -->
                <TextBlock Text="{l10n:L Input.PageSizeNote}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>
            </StackPanel>
        </Border>

        <!-- ── 翻页键 ──────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L Input.PagingKeys}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L Input.PagingKeys.Note}" Style="{StaticResource SectionIntro}"/>

                <CheckBox Content="{l10n:L Input.Paging.MinusEqual}" IsChecked="{Binding PagingMinusEqual}"
                          Margin="0,4"/>
                <CheckBox Content="{l10n:L Input.Paging.CommaPeriod}" IsChecked="{Binding PagingCommaPeriod}"
                          Margin="0,4"/>
                <CheckBox Content="{l10n:L Input.Paging.Brackets}" IsChecked="{Binding PagingBrackets}"
                          Margin="0,4"/>
                <CheckBox Content="{l10n:L Input.Paging.UpDown}" IsChecked="{Binding PagingUpDown}"
                          Margin="0,4"/>

                <!-- 中英切换键已移到「行为」页。
                     为什么不能两处都放：ascii_composer/switch_key 是**整块替换**的，
                     输入页这四个预设（None / Shift / CapsLock / Control）写下去会把
                     行为页逐键设置的 Caps_Lock=commit_code 之类整块冲掉，反过来也一样。
                     macOS 鼠须管面板里这一项本来就只在 BehaviorPage 一处，
                     行为页是它的严格超集（5 个键 × 6 种动作），所以归行为页独占。 -->
                <Border Style="{StaticResource Divider}"/>
                <TextBlock Text="{l10n:L Input.Switch.MovedToBehavior}"
                           Style="{StaticResource FieldNote}"/>

                <!-- 附加开关 -->
                <TextBlock Text="{l10n:L Input.Punct}" FontSize="{StaticResource FontSection}"
                           FontWeight="SemiBold" Margin="0,20,0,8"/>
                <CheckBox Content="{l10n:L Input.Punct.FullShape}" IsChecked="{Binding ToggleFullShape}"
                          Margin="0,4"/>
                <CheckBox Content="{l10n:L Input.Punct.Punctuation}" IsChecked="{Binding TogglePunctuation}"
                          Margin="0,4"/>
            </StackPanel>
        </Border>

        <!-- ── 应用 ────────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l10n:L Input.ApplyTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L Input.ApplyNote}" Style="{StaticResource SectionIntro}"/>

                <Border Style="{StaticResource CodeBlock}" Margin="{StaticResource GapActionRow}">
                    <ItemsControl ItemsSource="{Binding PreviewLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                           LineHeight="{StaticResource LineBody}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapActionRow}">
                    <Button Content="{l10n:L Input.ApplyBtn}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" Margin="0,0,10,0"/>
                    <Button Content="{l10n:L Common.Reload}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ReloadCommand}"/>
                </StackPanel>

                <Border Style="{StaticResource StatusStrip}">
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                               TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
