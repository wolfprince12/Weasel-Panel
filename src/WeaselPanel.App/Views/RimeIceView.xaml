<UserControl x:Class="WeaselPanel.App.Views.RimeIceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WeaselPanel.App.ViewModels">
    <!--
        排版约定（与项目既有的 ColorSchemesView 一致，ui-ux-pro-max 验收口径）：
        · 层次：页面标题 22 → 卡片小标题 14.5 → 段落说明 13 → 正文 13 → 脚注 11.5
        · 间距一律走 Sp/Gap token；能用留白就不用分割线（卡片之间靠 GapCard 而非 Divider）
        · 圆角只有三档：Sm 4 / Md 8 / Lg 12
        · 控件在未安装时整体置灰（IsEnabled={Binding IsInstalled}），但面板照常展示
    -->
    <StackPanel>
        <TextBlock Text="{l10n:L RimeIce.Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{l10n:L RimeIce.Intro}" Style="{StaticResource PageIntro}"/>

        <!-- 未安装横幅：整段置灰，但能力先让用户看清 -->
        <Border Style="{StaticResource StatusStrip}" Margin="{StaticResource GapCard}"
                Background="{StaticResource WarningSoftBrush}"
                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.NotInstalled}" FontSize="{StaticResource FontBody}"
                           FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"
                           TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
                <TextBlock Text="{l10n:L RimeIce.NotInstalled.Hint}" Style="{StaticResource FieldNote}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 基础开关 ──────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}"
                IsEnabled="{Binding IsInstalled}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.Basic.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Basic.Hint}" Style="{StaticResource SectionIntro}"/>

                <ItemsControl ItemsSource="{Binding SwitchRows}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RimeIceSwitchRow}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleText}" FontSize="{StaticResource FontBody}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatesText}" Style="{StaticResource FieldNote}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ModeOptions}"
                                          SelectedValuePath="Id" DisplayMemberPath="Name"
                                          SelectedValue="{Binding Mode}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l10n:L RimeIce.SaveOptions.Note}" Style="{StaticResource FieldNote}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 词库 ──────────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}"
                IsEnabled="{Binding IsInstalled}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.Hint}" Style="{StaticResource SectionIntro}"/>

                <CheckBox Content="{l10n:L RimeIce.Lexicon.MeltEng}" IsChecked="{Binding EnableMeltEng}"
                          Margin="0,14,0,0"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.MeltEng.Note}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.MeltEng.NeedEnglish}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}" Foreground="{StaticResource TextSecondaryBrush}"/>

                <CheckBox Content="{l10n:L RimeIce.Lexicon.CnEn}" IsChecked="{Binding EnableCnEn}"
                          Margin="0,12,0,0"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.CnEn.Note}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>

                <CheckBox Content="{l10n:L RimeIce.Lexicon.Radical}" IsChecked="{Binding EnableRadical}"
                          Margin="0,12,0,0"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.Radical.Note}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>

                <CheckBox Content="{l10n:L RimeIce.Lexicon.Emoji}" IsChecked="{Binding EnableEmojiDict}"
                          Margin="0,12,0,0"/>
                <TextBlock Text="{l10n:L RimeIce.Lexicon.Emoji.Note}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>
            </StackPanel>
        </Border>

        <!-- ── 语言与拼音 ────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}"
                IsEnabled="{Binding IsInstalled}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.Lang.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Lang.Hint}" Style="{StaticResource SectionIntro}"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l10n:L RimeIce.Opencc}" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OpenccOptions}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding Opencc}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l10n:L RimeIce.Pinyin}" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveSchemaText}"
                               FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l10n:L RimeIce.Pinyin.Hint}" Style="{StaticResource FieldNote}"
                           Margin="0,6,0,0"/>

                <CheckBox Content="{l10n:L RimeIce.Pinyin.RawCode}" IsChecked="{Binding ShowRawDoubleCode}"
                          Margin="0,16,0,0"
                          IsEnabled="{Binding IsDoublePinyinActive}"/>
                <TextBlock Text="{l10n:L RimeIce.Pinyin.RawCode.Hint}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}"/>
                <TextBlock Text="{l10n:L RimeIce.Pinyin.RawCode.Unavailable}" Style="{StaticResource FieldNote}"
                           Margin="{StaticResource GapNoteIndent}" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsDoublePinyinActive, Converter={StaticResource InverseBoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- ── 高级：Lua 滤镜 + 模糊音 ─────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}"
                IsEnabled="{Binding IsInstalled}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.Advanced.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Advanced.Hint}" Style="{StaticResource SectionIntro}"/>

                <TextBlock Text="{l10n:L RimeIce.Lua.Title}" Style="{StaticResource SubSectionTitle}"/>
                <ItemsControl ItemsSource="{Binding LuaRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RimeIceLuaRow}">
                            <StackPanel Margin="0,0,0,8">
                                <CheckBox IsChecked="{Binding IsOn}">
                                    <TextBlock Text="{Binding TitleText}" FontSize="{StaticResource FontBody}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </CheckBox>
                                <TextBlock Text="{Binding Key, StringFormat=lua_filter@\{0\}}"
                                           Style="{StaticResource MonoText}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l10n:L RimeIce.Lua.NeedEnglish}" Style="{StaticResource FieldNote}"
                           Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="{l10n:L RimeIce.Fuzzy.Title}" Style="{StaticResource SubSectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Fuzzy.Hint}" Style="{StaticResource FieldNote}"
                           Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding FuzzyGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RimeIceFuzzyGroup}">
                            <StackPanel Margin="0,0,0,14">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TitleText}"
                                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLabelBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                               Style="{StaticResource FieldNote}"/>
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RimeIceFuzzyRow}">
                                                <Border Style="{StaticResource ListFrame}" Margin="0,0,8,8"
                                                        Padding="10,6" IsEnabled="{Binding NotLocked}">
                                                    <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontCaption}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l10n:L RimeIce.Fuzzy.Locked}" Style="{StaticResource FieldNote}"
                           Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ── 原始 YAML 编辑 ─────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}"
                IsEnabled="{Binding IsInstalled}">
            <StackPanel>
                <TextBlock Text="{l10n:L RimeIce.Raw.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L RimeIce.Raw.Hint}" Style="{StaticResource SectionIntro}"/>

                <TextBox Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontCaption}"
                         Height="180" Margin="0,14,0,0"
                         BorderBrush="{StaticResource BorderBrushStrong}"
                         BorderThickness="{Binding RawHasError, Converter={StaticResource ErrThickness}}"/>

                <TextBlock Text="{Binding RawError}" Style="{StaticResource FieldNote}"
                           Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                           Visibility="{Binding RawHasError, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{l10n:L RimeIce.Raw.FilePath}" Style="{StaticResource FieldNote}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource MonoText}"
                               Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 应用 ─────────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapActionRow}">
                    <Button Content="{l10n:L Common.Apply}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding IsInstalled}"
                            Margin="0,0,10,0"/>
                    <Button Content="{l10n:L Common.Reload}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ReloadCommand}"/>
                </StackPanel>

                <Border Style="{StaticResource StatusStrip}">
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontBody}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="{StaticResource LineBody}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
