<UserControl x:Class="WeaselPanel.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
             xmlns:vm="clr-namespace:WeaselPanel.App.ViewModels">
    <StackPanel>

        <!-- ── 小狼毫控制面板 — 更新检查 ─────────────────────────
             对齐 macOS 鼠须管面板 AboutPage.updateCard：
             状态 icon + 主文字 + 副文字 + 右侧「检查更新 / 前往下载」按钮。
             图标用 TextBlock + 字符（✓ / ↑ / ! / ? / ⋯），不引入额外图标资源。
             按钮可见性由 ViewModel 的 PanelCheckVisibility / PanelDownloadVisibility 切换：
             状态==Available 时切到"前往下载"，其余走"检查/重试"。
             启动时由 AboutViewModel 自动触发一次 check；用户也可点按钮重新检查。 -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{StaticResource BgSubtleBrush}"
                        VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding PanelUpdateGlyph}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l10n:L About.PanelUpdate.Title}"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PanelUpdateText}"
                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PanelUpdateHint}"
                               FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               LineHeight="{StaticResource LineBody}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding CheckPanelUpdateCommand}"
                            Visibility="{Binding PanelCheckVisibility}"
                            Padding="14,6" MinWidth="96">
                        <TextBlock Text="{Binding PanelUpdateButtonText}"/>
                    </Button>
                    <Button Command="{Binding OpenPanelDownloadCommand}"
                            Visibility="{Binding PanelDownloadVisibility}"
                            Padding="14,6" MinWidth="96"
                            FontWeight="SemiBold">
                        <TextBlock Text="{Binding PanelUpdateButtonText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 小狼毫输入法 — 更新检查 ────────────────────────────
             对齐 macOS 鼠须管面板 AboutPage.squirrelUpdateCard，
             但目标仓库换为 rime/weasel。
             未检测到本体安装（无 ProgramDirectory）时：按钮自动 disabled
             （Command.CanExecute 由 IsInstalled 驱动，副标题切到"未安装"提示），
             与 macOS squirrelUpdateCard 的 !isInstalled 行为一致。 -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{StaticResource BgSubtleBrush}"
                        VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding WeaselUpdateGlyph}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l10n:L About.WeaselUpdate.Title}"
                               Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WeaselUpdateText}"
                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding WeaselUpdateHint}"
                               FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               LineHeight="{StaticResource LineBody}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding CheckWeaselUpdateCommand}"
                            Visibility="{Binding WeaselCheckVisibility}"
                            Padding="14,6" MinWidth="96">
                        <TextBlock Text="{Binding WeaselUpdateButtonText}"/>
                    </Button>
                    <Button Command="{Binding OpenWeaselDownloadCommand}"
                            Visibility="{Binding WeaselDownloadVisibility}"
                            Padding="14,6" MinWidth="96"
                            FontWeight="SemiBold">
                        <TextBlock Text="{Binding WeaselUpdateButtonText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 开发者 ──────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Developer.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding DeveloperName}"
                           FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding DeveloperRole}"
                           FontSize="{StaticResource FontBody}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DeveloperBio}"
                           FontSize="{StaticResource FontBody}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 更多作品（推广）──────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Promo.Title}" Style="{StaticResource SectionTitle}"/>
                <!-- 爻知云：左文字 + 右二维码（对齐鼠须管关于页 yaozhiCard） -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l10n:L About.Promo.Yaozhi.Title}"
                                       FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{l10n:L About.Promo.Yaozhi.Subtitle}"
                                       FontSize="{StaticResource FontCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l10n:L About.Promo.Yaozhi.Desc}"
                                   FontSize="{StaticResource FontBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   LineHeight="{StaticResource LineBody}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource CardBgBrush}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="6" SnapsToDevicePixels="True">
                        <Image x:Name="YaozhiQRImage" Height="140" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                <!-- 其余作品（DealV / DSonDT） -->
                <ItemsControl ItemsSource="{Binding PromoItems}" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{StaticResource FontCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="{StaticResource FontBody}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           LineHeight="{StaticResource LineBody}" Margin="0,4,0,0"/>
                                <!-- Hyperlink 必须放在 TextBlock 里；Hyperlink.Inlines
                                     只能用 Inline 子节点（<Run>），不能用 <TextBlock>。
                                     外层 TextBlock 的 HasValue DataTrigger 控制「有 URL
                                     才显示」—— 否则没链接的推广项会渲染一个空链接行。 -->
                                <TextBlock Margin="0,4,0,0">
                                    <Hyperlink NavigateUri="{Binding Url}"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{l10n:L About.Promo.Visit}"/>
                                    </Hyperlink>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── 运行状态 ────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Status.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding StatusSummary}"
                           FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 关于项目 ────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Project.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L About.Project.Desc}"
                           FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{l10n:L About.Project.Disclaimer}"
                           FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"/>
                <Border Style="{StaticResource Divider}" Margin="0,10,0,10"/>
                <!-- ⚠️ 之前是 <WrapPanel Orientation="Horizontal"> 里直接放 4 个 <Hyperlink>。
                     启动时 InitializeComponent 即崩：
                     System.Windows.Markup.XamlParseException:
                       "向类型为 UIElementCollection 的集合中添加值引发了异常；
                        无法将类型 Hyperlink 的实例添加到类型 UIElementCollection 的集合中。"
                     Hyperlink 是 Inline 不是 UIElement，只能活在 TextBlock 的 inlines 里。
                     改成 <StackPanel Orientation=Horizontal>，每个超链接单独放一个 TextBlock
                     容器里（StackPanel.Children 是 UIElementCollection，接受 TextBlock）。 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.RepoUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Repo}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.IssuesUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Issues}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.RimeUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Rime}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock>
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.WeaselUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Weasel}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 语言选择。存 %APPDATA%\WeaselPanel\settings.json，不碰 Rime 用户目录。 -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Language}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L About.LanguageIntro}" Style="{StaticResource SectionIntro}"/>
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                          SelectedValue="{Binding SelectedLanguage}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayName"
                          Width="220" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding LanguageNote}" Style="{StaticResource FieldNote}"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        </StackPanel>
</UserControl>