<UserControl x:Class="WeaselPanel.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
             xmlns:vm="clr-namespace:WeaselPanel.App.ViewModels">
    <StackPanel>

        <!-- ── 身份区 ──────────────────────────────────────────────
             这一页没有 PageTitle —— 应用名 + logo 本身就是标题，
             再加一个 22px 的「关于」就成了重复。 -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo：从嵌入式资源初始化（详见 AboutView.xaml.cs 的 LoadLogo）。
                         不要写 Source="pack://..." —— single-file 下 pack URI 会 NRE。
                         加载失败时由代码侧把 LogoImage.Visibility 设为 Collapsed，
                         FallbackText 显示纯文字占位。 -->
                    <Border Grid.Column="0" Width="96" Height="96" Margin="0,0,20,0"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{StaticResource BgSubtleBrush}">
                        <Image x:Name="LogoImage" Stretch="Uniform" Margin="12"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="FallbackText" Text="{l10n:L App.NameShort}"
                                   FontSize="{StaticResource FontHero}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Visibility="Collapsed" Margin="0,0,0,4"/>
                        <TextBlock Text="{l10n:L App.Name}" FontSize="{StaticResource FontSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{l10n:L About.Tagline}"
                                   FontSize="{StaticResource FontBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   MaxWidth="460" LineHeight="{StaticResource LineBody}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <!-- 版本 / 技术栈 / 许可 / 仓库。标签列宽与其它页统一。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:L About.Version}"
                               Style="{StaticResource FieldLabel}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}"
                               FontSize="{StaticResource FontBody}"
                               FontFamily="{StaticResource MonoFont}" Margin="0,4"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:L About.Tech}"
                               Style="{StaticResource FieldLabel}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TechValue}"
                               FontSize="{StaticResource FontBody}" Margin="0,4"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:L About.License}"
                               Style="{StaticResource FieldLabel}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseValue}"
                               FontSize="{StaticResource FontBody}" Margin="0,4"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l10n:L About.Repo}"
                               Style="{StaticResource FieldLabel}" Margin="0,4"/>
                    <!-- ⚠️ Hyperlink 必须放在 TextBlock 的 inlines 里；Hyperlink.Inlines
                         又只接受 Inline 子节点，所以内部用 <Run> 而非 <TextBlock>。
                         v0.2.5 真机踩坑：之前是 <TextBlock> → "Hyperlink 只能放在 TextBlock
                         的 inlines 里"已对，但 Hyperlink 里再放 TextBlock 会抛
                         XamlParseException（InlineCollection 不接受 UIElement）。 -->
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="{StaticResource FontBody}"
                               Margin="0,4" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.RepoUrl}"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{x:Static vm:AboutViewModel.RepoDisplay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── 开发者 ──────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Developer.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding DeveloperName}"
                           FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding DeveloperRole}"
                           FontSize="{StaticResource FontBody}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DeveloperBio}"
                           FontSize="{StaticResource FontBody}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 更多作品（推广）──────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Promo.Title}" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding PromoItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{StaticResource FontCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="{StaticResource FontBody}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           LineHeight="{StaticResource LineBody}" Margin="0,4,0,0"/>
                                <!-- Hyperlink 必须放在 TextBlock 里；Hyperlink.Inlines
                                     只能用 Inline 子节点（<Run>），不能用 <TextBlock>。
                                     外层 TextBlock 的 HasValue DataTrigger 控制「有 URL
                                     才显示」—— 否则没链接的推广项会渲染一个空链接行。 -->
                                <TextBlock Margin="0,4,0,0">
                                    <Hyperlink NavigateUri="{Binding Url}"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{l10n:L About.Promo.Visit}"/>
                                    </Hyperlink>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── 运行状态 ────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Status.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding StatusSummary}"
                           FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 关于项目 ────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Project.Title}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L About.Project.Desc}"
                           FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{l10n:L About.Project.Disclaimer}"
                           FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"/>
                <Border Style="{StaticResource Divider}" Margin="0,10,0,10"/>
                <!-- ⚠️ 之前是 <WrapPanel Orientation="Horizontal"> 里直接放 4 个 <Hyperlink>。
                     启动时 InitializeComponent 即崩：
                     System.Windows.Markup.XamlParseException:
                       "向类型为 UIElementCollection 的集合中添加值引发了异常；
                        无法将类型 Hyperlink 的实例添加到类型 UIElementCollection 的集合中。"
                     Hyperlink 是 Inline 不是 UIElement，只能活在 TextBlock 的 inlines 里。
                     改成 <StackPanel Orientation=Horizontal>，每个超链接单独放一个 TextBlock
                     容器里（StackPanel.Children 是 UIElementCollection，接受 TextBlock）。 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.RepoUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Repo}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.IssuesUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Issues}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0">
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.RimeUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Rime}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock>
                        <Hyperlink NavigateUri="{x:Static vm:AboutViewModel.WeaselUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{l10n:L About.Link.Weasel}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 语言选择。存 %APPDATA%\WeaselPanel\settings.json，不碰 Rime 用户目录。 -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Language}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l10n:L About.LanguageIntro}" Style="{StaticResource SectionIntro}"/>
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                          SelectedValue="{Binding SelectedLanguage}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayName"
                          Width="220" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding LanguageNote}" Style="{StaticResource FieldNote}"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="{StaticResource GapCard}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.HowItWorks}" Style="{StaticResource SectionTitle}"/>
                <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                           LineHeight="{StaticResource LineBody}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{l10n:L About.HowItWorksBody}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Env}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding EnvironmentSummary}"
                           Style="{StaticResource MonoText}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           LineHeight="{StaticResource LineBody}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>