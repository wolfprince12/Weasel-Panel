<UserControl x:Class="WeaselPanel.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l10n="clr-namespace:WeaselPanel.App.Localization">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo：从嵌入式资源初始化（详见 AboutView.xaml.cs 的 LoadLogo）。
                         不要写 Source="pack://..." —— single-file 下 pack URI 会 NRE。
                         加载失败时由代码侧把 LogoImage.Visibility 设为 Collapsed，
                         FallbackText 显示纯文字占位。 -->
                    <Grid Grid.Column="0" Width="88" Height="88" Margin="0,0,14,0">
                        <Image x:Name="LogoImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                        <TextBlock x:Name="FallbackText" Text="{l10n:L App.NameShort}"
                                   FontSize="28" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l10n:L App.Name}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{l10n:L About.Tagline}"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:L About.Version}"
                               Style="{StaticResource FieldLabel}" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}"
                               FontSize="12.5" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:L About.Tech}"
                               Style="{StaticResource FieldLabel}" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TechValue}"
                               FontSize="12.5" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:L About.License}"
                               Style="{StaticResource FieldLabel}" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseValue}"
                               FontSize="12.5" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l10n:L About.Repo}"
                               Style="{StaticResource FieldLabel}" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5" Margin="0,3">
                        <Hyperlink NavigateUri="{Binding RepoUrl}"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <TextBlock Text="{Binding RepoDisplay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 语言选择。存 %APPDATA%\WeaselPanel\settings.json，不碰 Rime 用户目录。 -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Language}" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="DisplayName"
                              Width="180" Height="32"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LanguageNote}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{l10n:L About.HowItWorks}" Style="{StaticResource SectionTitle}"/>
                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{l10n:L About.HowItWorksBody}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l10n:L About.Env}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding EnvironmentSummary}" FontSize="12"
                           FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
