<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 允许在非 Windows 主机上构建 Windows 桌面应用。
         这是本项目能在 macOS 上直接产出 exe 的关键开关，不要删除。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WeaselPanel</AssemblyName>
    <RootNamespace>WeaselPanel.App</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-preview</InformationalVersion>
    <Company>大狼导演工作室</Company>
    <Product>小狼毫控制面板</Product>
    <Copyright>GPL-3.0</Copyright>
    <!-- 单文件发布需要 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 让 exe 在资源管理器 / 任务栏显示小狼毫 logo。
         多尺寸 .ico 由 Pillow 从 Resources/logo.png 生成（16/24/32/48/64/128/256）。
         运行时窗口图标见 MainWindow.xaml 的 Icon 属性 —— ApplicationIcon 单独不显示在窗口上。 -->
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaselPanel.Core\WeaselPanel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeaselPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- logo 走 EmbeddedResource 而不是 WPF Resource，原因：
         .NET 8 self-contained + PublishSingleFile 下 pack://application:,,,/... URI
         会触发 NullReference（已知 WPF 打包 bug）。EmbeddedResource 走 Assembly
         GetManifestResourceStream，跟包内 WPF 资源解析器无关，single-file 下稳。

         APP 图标 Resources/app.ico 仍用 ApplicationIcon + 它自己的 Resource 项，
         二者各管一摊：app.ico → 任务栏 / 资源管理器；logo.png → 关于页内显示。 -->
    <EmbeddedResource Include="Resources\logo.png" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
