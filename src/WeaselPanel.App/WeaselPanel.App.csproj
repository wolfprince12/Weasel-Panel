<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 允许在非 Windows 主机上构建 Windows 桌面应用。
         这是本项目能在 macOS 上直接产出 exe 的关键开关，不要删除。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WeaselPanel</AssemblyName>
    <RootNamespace>WeaselPanel.App</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-preview</InformationalVersion>
    <Company>大狼导演工作室</Company>
    <Product>小狼毫控制面板</Product>
    <Copyright>GPL-3.0</Copyright>
    <!-- 单文件发布需要 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 让 exe 在资源管理器 / 任务栏显示小狼毫 logo。
         多尺寸 .ico 由 Pillow 从 Resources/logo.png 生成（16/24/32/48/64/128/256）。
         运行时窗口图标见 MainWindow.xaml 的 Icon 属性 —— ApplicationIcon 单独不显示在窗口上。 -->
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaselPanel.Core\WeaselPanel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeaselPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF 默认把 Resources/ 当 Content；这里显式声明为 Resource（嵌入程序集），
         使 pack://application:,,,/Resources/app.ico 之类的 URI 能解析到。 -->
    <Resource Include="Resources/app.ico" />
    <Resource Include="Resources/logo.png" />
  </ItemGroup>

</Project>
