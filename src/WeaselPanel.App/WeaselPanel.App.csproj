<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 只为借用 System.Windows.Forms.ColorDialog 这一个类。
         WPF 至今没有内置取色器，自己撸一组 RGB/Alpha 滑块既难用又不好看；
         原生颜色对话框用户熟悉、支持自定义色板，是 Windows 上该有的样子。
         System.Drawing.Common 随 Microsoft.WindowsDesktop.App.WindowsForms 一起提供，
         不需要额外包引用；两个 Use* 开关可以同开，官方支持 WPF/WinForms 混用。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 允许在非 Windows 主机上构建 Windows 桌面应用。
         这是本项目能在 macOS 上直接产出 exe 的关键开关，不要删除。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WeaselPanel</AssemblyName>
    <RootNamespace>WeaselPanel.App</RootNamespace>
    <!-- ⚠️ 每次重新发 exe 都 +1。标题栏显示这个版本号，是判断「VM 上跑的是哪一版」
         的最快凭据 —— 之前连续两轮修复都栽在「以为测的是新版、其实是旧 exe」。
         别只改这里：./build.sh 出包时会用 tools/verify_lang_packs.py 拿每包里
         最长的若干条原文当哨兵真搜 exe，搜不到就让构建失败。 -->
    <Version>0.1.15</Version>
    <InformationalVersion>0.1.15-preview</InformationalVersion>
    <Company>大狼导演工作室</Company>
    <Product>小狼毫控制面板</Product>
    <Copyright>GPL-3.0</Copyright>
    <!-- 单文件发布需要 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- 只交付 x64（2026-09-02 用户拍板）。
         默认即 win-x64；未写死，需要其他架构时用 `dotnet publish -r <RID>` 覆盖。
         日常请用 ./build.sh，它固定产出 x64 并会顺手清掉已废弃的 win-arm64 产物。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 让 exe 在资源管理器 / 任务栏显示小狼毫 logo。
         多尺寸 .ico 由 Pillow 从 Resources/logo.png 生成（16/24/32/48/64/128/256）。
         运行时窗口图标见 MainWindow.xaml 的 Icon 属性 —— ApplicationIcon 单独不显示在窗口上。 -->
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ⚠️ 开 WinForms 会让 SDK 自动加上 `global using System.Windows.Forms;`，
       于是 System.Windows.Forms.UserControl / Application 与 WPF 的同名类型
       全面歧义，12 个已有视图直接编译不过。这里把它的全局 using 摘掉 ——
       只是去掉「自动引入命名空间」，不影响运行时，ColorDialog 照常可用，
       本项目里唯一需要 WinForms 的地方全部用全名书写（见 ColorSchemesViewModel）。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaselPanel.Core\WeaselPanel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeaselPanel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- logo 走 EmbeddedResource 而不是 WPF Resource，原因：
         .NET 8 self-contained + PublishSingleFile 下 pack://application:,,,/... URI
         会触发 NullReference（已知 WPF 打包 bug）。EmbeddedResource 走 Assembly
         GetManifestResourceStream，跟包内 WPF 资源解析器无关，single-file 下稳。

         APP 图标 Resources/app.ico 仍用 ApplicationIcon + 它自己的 Resource 项，
         二者各管一摊：app.ico → 任务栏 / 资源管理器；logo.png → 关于页内显示。 -->
    <EmbeddedResource Include="Resources\logo.png" />

    <!-- ⚠️ 语言包必须显式声明。.NET SDK 的默认 EmbeddedResource glob 只收 **/*.resx，
         .txt 一律归到 None —— 不写这一行，三个 lang.*.txt 根本不会进程序集，
         L10n.LoadAllPacks() 的 GetManifestResourceNames() 只会看到 logo.png，
         于是 _packs 为空、T(key) 原样返回键名，整个界面变成 "App.Name" "Nav.Diagnostics"。
         这个坑 2026-09-02 踩过一次：exe 里能搜到「小狼毫控制面板」，但那是 csproj
         <Product> 写进 PE 版本信息的假阳性，语言包其实一个字节都没进去。
         防复发靠 build.sh 的 verify_language_packs()，出包时会拿每包的哨兵串真搜 exe。 -->
    <EmbeddedResource Include="Localization\lang.*.txt" />

    <!-- ⚠️ 紫毫纠错引擎资源（lua 脚本 + 1MB 正向词表）也必须走 EmbeddedResource。
         本项目是 PublishSingleFile 发布、用户只从 dist/ 拿走一个 exe，
         用 <Content CopyToOutputDirectory> 的话文件只会躺在 dist/ 里，
         被落单的 exe 一辈子找不到 —— 表现是「纠错开关能开、但一条纠错候选都不出」，
         完全静默。运行时由 Services/CorrectionAssets.cs 解到
         %LOCALAPPDATA%\WeaselPanel\CorrectionEngine 再交给 Core 部署。
         同理，词表体积（约 1MB）对已经 156MB 的自包含 exe 可以忽略。 -->
    <EmbeddedResource Include="Assets\CorrectionEngine\lua\amethyst_corrector.lua" />
    <EmbeddedResource Include="Assets\CorrectionEngine\data\correction_pinyin.txt" />
    <!-- app.ico 不再声明为 <Resource>：<ApplicationIcon> 已经足够让图标进 PE 资源
         （任务栏 / 资源管理器读的就是它）。多声明一个 WPF Resource 反而会在
         single-file 下多出一条 pack 解析路径，是已知的 NRE 风险源。 -->
  </ItemGroup>

</Project>
