<Window x:Class="WeaselPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
        xmlns:local="clr-namespace:WeaselPanel.App"
        Title="Weasel Panel"
        Width="1000" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Loaded="Window_Loaded">
    <!-- 窗口标题栏 / 任务栏图标由 csproj 的 <ApplicationIcon> 单独管。
         XAML 上不要写 Icon="pack://..." —— single-file 发布下会 NullReference。

         这里的 Title 只是"InitializeComponent 期间"的占位；真正的标题在
         Window_Loaded 里按当前语言拼装（含版本号与构建时间），并在用户
         切换语言时重新生成 —— 版本号是判断「VM 上跑的是哪一版」的最快凭据，
         之前连续两轮修复都栽在「以为测的是新版、其实是旧 exe」。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 侧边导航 ─────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0"
                SnapsToDevicePixels="True">
            <Grid Margin="8,20,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌区：居中，仿鼠须管侧栏顶部的 Logo + 产品名 + 版本。
                     96×96 圆角方块（复用 About 页的嵌入式 logo.png），加载失败时
                     降级为纯文字占位，不让整块崩。 -->
                <StackPanel Grid.Row="0" Margin="0,6,0,18" HorizontalAlignment="Center">
                    <Border Width="96" Height="96" CornerRadius="{StaticResource RadiusLg}"
                            Background="{StaticResource BgSubtleBrush}" SnapsToDevicePixels="True">
                        <Grid Margin="14">
                            <Image x:Name="BrandLogo" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"/>
                            <TextBlock x:Name="BrandFallback" Text="{l10n:L App.NameShort}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{l10n:L App.NameShort}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="BrandVersion" FontSize="{StaticResource FontMicro}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <!-- 顺序严格对齐鼠须管（squirrel）侧栏：
                         外观 → 输入方案 → 雾凇拼音 → 词库 → 紫毫纠错 → 按键与行为
                         → 备份与维护 → 应用选项 → 维护 → 关于。
                         小狼毫（Windows）独占的面板就近插入：诊断(首)、自定义配色(紧跟外观)、
                         词库包(紧跟词库)、配置查看器(工具组)。
                         ⚠️ 顺序必须与 MainWindow.xaml.cs 的 NavViews 数组逐一对应；
                            改动这里必须同步改 NavViews，否则「点维护跳出词典」。

                         Tag = 组标题（仅组内首项带，由 NavItem 模板在该项头顶渲染一行小字）；
                         local:NavItemHelper.Tint = 按面板语义的图标着色（仿 squirrel listItemTint）。 -->
                    <ListBoxItem Content="{l10n:L Nav.Diagnostics}"
                                 local:NavItemHelper.Icon="&#xE9D0;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintRed}"/>

                    <ListBoxItem Content="{l10n:L Nav.Appearance}"
                                 Tag="{l10n:L NavGroup.Appearance}"
                                 local:NavItemHelper.Icon="&#xE790;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintOrange}"/>
                    <ListBoxItem Content="{l10n:L Nav.ColorSchemes}"
                                 local:NavItemHelper.Icon="&#xE7AB;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintOrange}"/>

                    <ListBoxItem Content="{l10n:L Nav.Schema}"
                                 Tag="{l10n:L NavGroup.Input}"
                                 local:NavItemHelper.Icon="&#xE8A5;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintGreen}"/>
                    <ListBoxItem Content="{l10n:L Nav.RimeIce}"
                                 local:NavItemHelper.Icon="&#xE753;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintTeal}"/>

                    <ListBoxItem Content="{l10n:L Nav.Dictionary}"
                                 Tag="{l10n:L NavGroup.Data}"
                                 local:NavItemHelper.Icon="&#xE7B7;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintPink}"/>
                    <ListBoxItem Content="{l10n:L Nav.Packages}"
                                 local:NavItemHelper.Icon="&#xE7B8;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintPink}"/>

                    <ListBoxItem Content="{l10n:L Nav.Correction}"
                                 Tag="{l10n:L NavGroup.Correction}"
                                 local:NavItemHelper.Icon="&#xE7E0;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintMint}"/>

                    <ListBoxItem Content="{l10n:L Nav.Input}"
                                 Tag="{l10n:L NavGroup.Keys}"
                                 local:NavItemHelper.Icon="&#xE765;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintIndigo}"/>
                    <ListBoxItem Content="{l10n:L Nav.Behavior}"
                                 local:NavItemHelper.Icon="&#xE713;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintIndigo}"/>

                    <ListBoxItem Content="{l10n:L Nav.Backup}"
                                 Tag="{l10n:L NavGroup.Maintenance}"
                                 local:NavItemHelper.Icon="&#xE74E;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintBrown}"/>
                    <ListBoxItem Content="{l10n:L Nav.AppOptions}"
                                 local:NavItemHelper.Icon="&#xE7F4;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintBlue}"/>
                    <ListBoxItem Content="{l10n:L Nav.Maintenance}"
                                 local:NavItemHelper.Icon="&#xE7D9;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintPurple}"/>

                    <ListBoxItem Content="{l10n:L Nav.Inspector}"
                                 Tag="{l10n:L NavGroup.Tools}"
                                 local:NavItemHelper.Icon="&#xE721;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintGray}"/>

                    <ListBoxItem Content="{l10n:L Nav.About}"
                                 Tag="{l10n:L NavGroup.Meta}"
                                 local:NavItemHelper.Icon="&#xE946;"
                                 local:NavItemHelper.Tint="{StaticResource NavTintGray}"/>
                </ListBox>

                <!-- 底部统一部署栏（仿鼠须管侧栏「应用并重新部署」）：
                     上方状态行（应用进度圈 + 待保存/已保存文案），
                     中间「查看 YAML / 放弃更改」次要操作，下方全宽主按钮，
                     再下方一行脚注说明改动落点。只应用有未保存改动的面板，统一重部署一次。 -->
                <StackPanel Grid.Row="2" x:Name="DeployBarHost" Margin="0,12,0,0">
                    <!-- 状态行：应用进行中显示进度条；有未保存改动文案用橙色（仿 squirrel footer.dirty），
                         否则用次文字色。绑 _deploy 的属性，DataContext 在 ctor 里已指向 _deploy。 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Width="90" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}"
                                     Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusBrush}"
                                   FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ViewYamlCommand}"
                                Content="{l10n:L Deploy.ViewYaml}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding DiscardCommand}"
                                Content="{l10n:L Deploy.Discard}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyDeployCommand}"
                            Content="{l10n:L Deploy.Apply}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{l10n:L Deploy.Note}"
                               FontSize="{StaticResource FontMicro}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 内容区 ─────────────────────────────────
             顶部横幅区（仿 squirrel 顶部 Banner：未装小狼毫 / 用户目录未就绪），
             下方才是各面板内容。限宽到 920（见 App.xaml 的 ContentMaxWidth），
             窄窗口下不生效，宽窗口下内容靠左维持与侧栏的阅读连续性。 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0" Margin="0">
            <StackPanel>
                <!-- 横幅区：DataContext 由 ctor 指向 _deploy（与 DeployBarHost 同源）。
                     Banners 为空（已安装且用户目录就绪）时整块折叠，不占空间。 -->
                <ItemsControl x:Name="BannerHost"
                              Visibility="{Binding HasBanners, Converter={StaticResource BoolToVisibility}}"
                              Margin="24,16,24,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:BannerItem">
                            <Border Margin="0,0,0,10" CornerRadius="{StaticResource RadiusMd}"
                                    Background="{Binding TintBrush}"
                                    BorderBrush="{Binding TextBrush}" BorderThickness="1">
                                <Grid Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                            Background="{Binding TextBrush}" Opacity="0.16"
                                            Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{Binding TextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                               FontSize="{StaticResource FontBody}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="ContentHost" Grid.Column="0" Margin="24,22,24,28"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
