<Window x:Class="WeaselPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小狼毫控制面板 — 预览版"
        Width="960" Height="640" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Loaded="Window_Loaded">
    <!-- 窗口标题栏 / 任务栏图标由 csproj 的 <ApplicationIcon> 单独管。
         XAML 上不要写 Icon="pack://..." —— single-file 发布下会 NullReference。
         标题里"预览版"提醒用户这是早期版本，期望对崩溃栈宽容。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 侧边导航 ─────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0">
            <Grid Margin="8,18,8,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,0,8,18">
                    <TextBlock Text="小狼毫" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="控制面板" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <!-- 不要在这里写 IsSelected="True"。InitializeComponent 解析到这个
                         ListBoxItem 时会立刻同步触发 SelectionChanged，但 _diagnosticsView
                         等字段在 ctor 体里还要一会儿才 new 好，回调里 _appearanceView 还是
                         null，直接 NRE。改由 ctor 末尾在所有 view 就绪后手动设
                         Nav.SelectedIndex = 0 触发首次切换。 -->
                    <ListBoxItem Content="环境诊断"/>
                    <ListBoxItem Content="外观"/>
                    <ListBoxItem Content="方案"/>
                    <ListBoxItem Content="备份"/>
                    <ListBoxItem Content="关于"/>
                </ListBox>

                <TextBlock Grid.Row="2" Text="v0.1.0 preview" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── 内容区 ───────────────────────────────── -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="ContentHost" Margin="22,20"/>
        </ScrollViewer>
    </Grid>
</Window>
