<Window x:Class="WeaselPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:WeaselPanel.App.Localization"
        Title="Weasel Panel"
        Width="1000" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Loaded="Window_Loaded">
    <!-- 窗口标题栏 / 任务栏图标由 csproj 的 <ApplicationIcon> 单独管。
         XAML 上不要写 Icon="pack://..." —— single-file 发布下会 NullReference。

         这里的 Title 只是"InitializeComponent 期间"的占位；真正的标题在
         Window_Loaded 里按当前语言拼装（含版本号与构建时间），并在用户
         切换语言时重新生成 —— 版本号是判断「VM 上跑的是哪一版」的最快凭据，
         之前连续两轮修复都栽在「以为测的是新版、其实是旧 exe」。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 侧边导航 ─────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0"
                SnapsToDevicePixels="True">
            <Grid Margin="8,20,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌区。副标题不写死「Rime 设置面板」这类营销语，
                     就写它是什么，克制。 -->
                <StackPanel Grid.Row="0" Margin="14,0,8,20">
                    <TextBlock Text="{l10n:L App.NameShort}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{l10n:L App.Subtitle}" FontSize="{StaticResource FontCaption}"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="{StaticResource LineCaption}"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <!-- 不要在这里写 IsSelected="True"。InitializeComponent 解析到这个
                         ListBoxItem 时会立刻同步触发 SelectionChanged，但 _diagnosticsView
                         等字段在 ctor 体里还要一会儿才 new 好，回调里 _appearanceView 还是
                         null，直接 NRE。改由 ctor 末尾在所有 view 就绪后直接赋首屏。 -->
                    <!-- ⚠️ Tag = 组标题，由 NavItem 模板在该项上方渲染一行小字。
                         组标题**不是**独立条目 —— 导航按 SelectedIndex 派发，
                         多插一项就会「点维护跳出词典」，所以分组只能挂 Tag。
                         只有「组内第一项」带 Tag，其余不带。
                         首项「环境诊断」紧贴品牌区，不需要再压一行标题。 -->
                    <ListBoxItem Content="{l10n:L Nav.Diagnostics}"/>

                    <ListBoxItem Content="{l10n:L Nav.Appearance}" Tag="{l10n:L NavGroup.Appearance}"/>
                    <!-- 自定义配色紧挨「外观」：两页都管配色，
                         外观是「选哪一套」，这里是「造一套」。 -->
                    <ListBoxItem Content="{l10n:L Nav.ColorSchemes}"/>

                    <ListBoxItem Content="{l10n:L Nav.Schema}" Tag="{l10n:L NavGroup.Input}"/>
                    <!-- 雾凇拼音紧挨「输入方案」：rime_ice 本身是一个拼音方案，
                         方案页管「装哪些、谁在前」，这里管「这一套内部的词库/模糊音/繁简」。 -->
                    <ListBoxItem Content="{l10n:L Nav.RimeIce}"/>
                    <ListBoxItem Content="{l10n:L Nav.Input}"/>
                    <ListBoxItem Content="{l10n:L Nav.Behavior}"/>
                    <ListBoxItem Content="{l10n:L Nav.AppOptions}"/>

                    <ListBoxItem Content="{l10n:L Nav.Dictionary}" Tag="{l10n:L NavGroup.Data}"/>
                    <ListBoxItem Content="{l10n:L Nav.Maintenance}"/>
                    <ListBoxItem Content="{l10n:L Nav.Inspector}"/>
                    <ListBoxItem Content="{l10n:L Nav.Backup}"/>

                    <ListBoxItem Content="{l10n:L Nav.About}" Tag="{l10n:L NavGroup.Meta}"/>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="VersionLabel" Text=""
                           FontSize="{StaticResource FontMicro}"
                           Foreground="{StaticResource TextDisabledBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <!-- ── 内容区 ─────────────────────────────────
             MaxWidth + 左对齐是本轮排版复审最关键的一处修正。原来是纯 `*`，
             窗口最大化后内容区能有 2000+ 像素宽：说明文字一行 200 多字符、
             「标签 : 控件」中间拉出一大片空白、复选框注释横贯整屏 ——
             十三个页面**全部**受影响，这就是「各个页面排版很有问题」的总根源。
             限宽到 920（见 App.xaml 的 ContentMaxWidth），窄窗口下不生效，
             宽窗口下内容靠左维持与侧栏的阅读连续性（跟 Windows 11 设置一致，
             不居中 —— 居中会让内容在超宽屏上飘到屏幕正中、与左侧导航断开）。 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0" Margin="0">
            <!-- 为什么用「star 列 + MaxWidth」而不是给 ContentControl 直接写
                 HorizontalAlignment=Left + MaxWidth：Left 对齐的元素宽度是**按内容收缩**的，
                 于是每页宽度都不一样（哪页恰好有一行长文字，那页的卡片就更宽），
                 页间切换时卡片右边缘会跳。而 Stretch + MaxWidth 在 WPF 里是**居中**，
                 超宽屏上内容会飘到屏幕正中、和左侧导航断开。
                 star 列受 MaxWidth 限制后停在 920 且靠左，右侧富余空间由 Auto 列吃掉，
                 是唯一能同时满足「定宽 + 靠左」的写法。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource ContentMaxWidth}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ContentHost" Grid.Column="0" Margin="24,22,24,28"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
